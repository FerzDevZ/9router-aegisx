# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.
#
# Secrets: leave these UNSET to get strong per-install generated values —
# JWT_SECRET falls back to a random secret persisted at DATA_DIR/jwt-secret,
# INITIAL_PASSWORD to a random password printed to the console on first run
# (stored at DATA_DIR/initial-password until you set a permanent one).
# Copying this file verbatim must never produce a guessable credential.
# JWT_SECRET=
# INITIAL_PASSWORD=
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
# Per-install secret for API-key CRC derivation — CHANGE THIS (the default is
# public; a shared value makes key checksums guessable across installs).
API_KEY_SECRET=change-me-random-per-install
# Optional: only affects the NON-secret machine identifier (grouping/display).
# CLI/token authentication derives from a separate random per-install secret
# persisted under DATA_DIR/auth — no env needed for that.
MACHINE_ID_SALT=
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Base URL of this instance (SSO/OIDC + SAML callback resolution).
# Server-side preferred; the NEXT_PUBLIC_ variant is still read by client code.
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Headroom compression service URL (docker-compose sets this; headroom is optional)
# HEADROOM_URL=http://127.0.0.1:8787

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
